# Docker Compose settings. Keep these values aligned with config/config.yml.
# Set the passwords in your local .env before starting Compose.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=iChat
MYSQL_PORT=3306

REDIS_PASSWORD=
REDIS_PORT=6379

# mqadmin reads these settings from .env; never use the admin account in the app.
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_APP_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
